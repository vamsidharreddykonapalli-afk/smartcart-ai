# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For LOCAL development (current):
# MONGO_URI=mongodb://localhost:27017/smartcart-ai

# For PRODUCTION (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartcart-ai?retryWrites=true&w=majority

MONGO_URI=mongodb://localhost:27017/smartcart-ai

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this-in-production
JWT_EXPIRE=7d

# OpenAI API (for AI suggestions - optional for now)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Price Update Frequency (in milliseconds)
PRICE_UPDATE_INTERVAL=3600000

# Optional: Email Configuration (for future features)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
